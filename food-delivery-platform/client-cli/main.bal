import ballerina/io;
import ballerina/http;

configurable string customerServiceUrl = "http://localhost:9001/customers";
configurable string restaurantServiceUrl = "http://localhost:9002/restaurants";
configurable string orderServiceUrl = "http://localhost:9003/orders";
configurable string deliveryServiceUrl = "http://localhost:9005/deliveries";
configurable string adminServiceUrl = "http://localhost:9006/admin/reports";

final http:Client customerClient;
final http:Client restaurantClient;
final http:Client orderClient;
final http:Client deliveryClient;
final http:Client adminClient;

function init() returns error? {
    customerClient = check new (customerServiceUrl);
    restaurantClient = check new (restaurantServiceUrl);
    orderClient = check new (orderServiceUrl);
    deliveryClient = check new (deliveryServiceUrl);
    adminClient = check new (adminServiceUrl);
}

public function main() {
    io:println("=================================================");
    io:println(" Welcome to the Distributed Food Delivery System ");
    io:println("=================================================");

    while true {
        io:println("\n--- MAIN MENU ---");
        io:println("1. Customer Management");
        io:println("2. Restaurant Management");
        io:println("3. Delivery & Driver Management");
        io:println("4. View Admin Reports");
        io:println("5. Exit");
        
        string choice = io:readln("Enter choice: ");
        
        match choice.trim() {
            "1" => { handleCustomerMenu(); }
            "2" => { handleRestaurantMenu(); }
            "3" => { handleDeliveryMenu(); }
            "4" => { handleAdminMenu(); }
            "5" => {
                io:println("Goodbye!");
                break;
            }
            _ => { io:println("Invalid option. Please try again."); }
        }
    }
}

// ---------------- CUSTOMER MENU ----------------
function handleCustomerMenu() {
    while true {
        io:println("\n-- Customer Menu --");
        io:println("1. Register New Customer");
        io:println("2. View Customer Profile");
        io:println("3. Add Balance to Customer");
        io:println("4. Browse Registered Restaurants & Menus (Location, Food Name, Menu ID & Quantity Available)");
        io:println("5. Place an Order");
        io:println("6. Track Order Status");
        io:println("7. View Customer Order History");
        io:println("8. Cancel an Order");
        io:println("9. Back to Main Menu");
        
        string choice = io:readln("Enter choice: ");
        match choice.trim() {
            "1" => {
                io:println("\n[ Register New Customer ]");
                string name = io:readln("Enter Name: ").trim();
                string email = io:readln("Enter Email: ").trim();
                string address = io:readln("Enter Delivery Address: ").trim();
                string balStr = io:readln("Enter Starting Balance: ").trim();
                
                // Input validations
                if name == "" || email == "" || address == "" {
                    io:println("Error: All fields are required! Returning to menu...");
                    continue;
                }
                
                if !isValidEmail(email) {
                    io:println("Error: Invalid email format! Please enter a valid email address (e.g. user@example.com).");
                    continue;
                }
                
                decimal|error balanceRes = decimal:fromString(balStr);
                if balanceRes is error || balanceRes < 0.0d {
                    io:println("Error: Invalid starting balance! Starting balance cannot be negative.");
                    continue;
                }
                
                json customerPayload = {
                    id: "", // Auto-generated by backend
                    name: name,
                    email: email,
                    address: address,
                    balance: balanceRes
                };
                
                do {
                    http:Response res = check customerClient->post("/", customerPayload);
                    if res.statusCode == http:STATUS_CREATED {
                        json registered = check res.getJsonPayload();
                        io:println("\n======================================================================");
                        io:println(" CUSTOMER REGISTRATION SUCCESSFUL");
                        io:println("======================================================================");
                        io:println(" Customer ID : ", check registered.id);
                        io:println(" Full Name   : ", check registered.name);
                        io:println(" Email       : ", check registered.email);
                        io:println(" Address     : ", check registered.address);
                        io:println(" Balance     : $", check registered.balance);
                        io:println("======================================================================");
                    } else if res.statusCode == http:STATUS_CONFLICT {
                        io:println("\nError: A customer with this email already exists! Email addresses must be unique.");
                    } else if res.statusCode == http:STATUS_BAD_REQUEST {
                        io:println("\nError: Invalid registration data provided. Starting balance cannot be negative.");
                    } else {
                        io:println("\nError: Server returned status code " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: Unable to communicate with Customer Service. (" + err.message() + ")");
                }
            }
            "2" => {
                string id = io:readln("Enter Customer ID: ").trim();
                if id == "" {
                    io:println("Error: Customer ID cannot be empty.");
                    continue;
                }
                do {
                    http:Response res = check customerClient->get("/" + id);
                    if res.statusCode == http:STATUS_OK {
                        json cJson = check res.getJsonPayload();
                        io:println("\n======================================================================");
                        io:println(" CUSTOMER PROFILE DETAILS");
                        io:println("======================================================================");
                        io:println(" Customer ID : ", check cJson.id);
                        io:println(" Full Name   : ", check cJson.name);
                        io:println(" Email       : ", check cJson.email);
                        io:println(" Address     : ", check cJson.address);
                        io:println(" Balance     : $", check cJson.balance);
                        io:println("======================================================================");
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("Error: Customer ID '" + id + "' not found.");
                    } else {
                        io:println("Error: Server returned status " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "3" => {
                string id = io:readln("Enter Customer ID: ").trim();
                string amtStr = io:readln("Enter Deposit Amount: ").trim();
                
                decimal|error amountRes = decimal:fromString(amtStr);
                if amountRes is error || amountRes <= 0.0d {
                    io:println("Error: Invalid deposit amount! Please enter a positive numerical value.");
                    continue;
                }
                
                do {
                    json payload = { amount: amountRes };
                    http:Response res = check customerClient->post("/" + id + "/add-balance", payload);
                    if res.statusCode == http:STATUS_OK {
                        io:println("Funds deposited successfully!");
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("Error: Customer ID '" + id + "' not found.");
                    } else {
                        io:println("Error: Failed to deposit funds. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "4" => {
                io:println("\n[ Registered Restaurants & Menus ]");
                do {
                    http:Response res = check restaurantClient->get("/");
                    if res.statusCode == http:STATUS_OK {
                        json payload = check res.getJsonPayload();
                        json[] restaurants = <json[]>payload;
                        
                        if restaurants.length() == 0 {
                            io:println("No registered restaurants found.");
                        } else {
                            foreach json r in restaurants {
                                string restId = check r.id;
                                string name = check r.name;
                                string address = check r.address;
                                boolean isOpen = check r.isOpen;
                                
                                io:println("\n======================================================================");
                                io:println(" Restaurant Name : " + name + " (ID: " + restId + ")");
                                io:println(" Location / Addr : " + address + " | Status: " + (isOpen ? "Open" : "Closed"));
                                io:println(" ----------------------------------------------------------------------");
                                io:println(" MENU ITEMS & AVAILABLE STOCK:");
                                
                                json[] menu = <json[]>check r.menu;
                                json inventoryMap = check r.inventory;
                                
                                if menu.length() == 0 {
                                    io:println("   (No menu items added yet)");
                                } else {
                                    foreach json m in menu {
                                        string menuId = check m.id;
                                        string foodName = check m.name;
                                        decimal price = check m.price;
                                        
                                        int stock = 0;
                                        if inventoryMap is map<json> && inventoryMap.hasKey(menuId) {
                                            stock = check int:fromString(inventoryMap.get(menuId).toString());
                                        }
                                        
                                        io:println(string `   * Food Name          : ${foodName}`);
                                        io:println(string `     Menu Item ID       : ${menuId}`);
                                        io:println(string `     Price              : $${price}`);
                                        io:println(string `     Quantity Available : ${stock}`);
                                        io:println("   ----------------------------------");
                                    }
                                }
                                io:println("======================================================================");
                            }
                        }
                    } else {
                        io:println("Error: Failed to fetch restaurants. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: Unable to fetch restaurants (" + err.message() + ")");
                }
            }
            "5" => {
                io:println("\n[ Place an Order ]");
                string custId = io:readln("Enter Customer ID: ").trim();
                string restId = io:readln("Enter Restaurant ID: ").trim();
                string itemId = io:readln("Enter Menu Item ID: ").trim();
                string qtyStr = io:readln("Enter Quantity: ").trim();
                
                if custId == "" || restId == "" || itemId == "" {
                    io:println("Error: Customer ID, Restaurant ID, and Menu Item ID are required.");
                    continue;
                }
                
                int|error qtyRes = int:fromString(qtyStr);
                if qtyRes is error || qtyRes <= 0 {
                    io:println("Error: Invalid quantity! Please enter a positive whole number.");
                    continue;
                }
                
                json payload = {
                    customerId: custId,
                    restaurantId: restId,
                    items: [
                        {
                            itemId: itemId,
                            quantity: qtyRes
                        }
                    ]
                };
                
                do {
                    http:Response res = check orderClient->post("/", payload);
                    if res.statusCode == http:STATUS_CREATED {
                        json ord = check res.getJsonPayload();
                        io:println("\n======================================================================");
                        io:println(" ORDER PLACEMENT SUCCESSFUL");
                        io:println("======================================================================");
                        io:println(" Order ID       : ", check ord.id);
                        io:println(" Delivery ID    : ", check ord.deliveryId);
                        io:println(" Customer ID    : ", check ord.customerId);
                        io:println(" Restaurant ID : ", check ord.restaurantId);
                        io:println(" Total Price   : $", check ord.totalPrice);
                        io:println(" Status        : ", check ord.status);
                        io:println(" Order Date    : ", check ord.createdAt);
                        io:println("======================================================================");
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("Error: Specified Customer ID or Restaurant ID was not found.");
                    } else if res.statusCode == http:STATUS_BAD_REQUEST {
                        io:println("Error: Order request failed. Orders can only be placed between 09:00 and 21:00 (UTC+02:00 Windhoek time), or check item ID, stock, or balance.");
                    } else {
                        io:println("Error: Failed to place order. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: Unable to communicate with Order Service. (" + err.message() + ")");
                }
            }
            "6" => {
                string id = io:readln("Enter Order ID or Delivery ID: ").trim();
                if id == "" {
                    io:println("Error: ID cannot be empty.");
                    continue;
                }
                do {
                    http:Response res = check orderClient->get("/" + id);
                    if (res.statusCode == http:STATUS_OK) {
                        json ord = check res.getJsonPayload();
                        io:println("\n======================================================================");
                        io:println(" ORDER & DELIVERY TRACKING DETAILS");
                        io:println("======================================================================");
                        io:println(" Order ID       : ", check ord.id);
                        io:println(" Delivery ID    : ", check ord.deliveryId);
                        io:println(" Customer ID    : ", check ord.customerId);
                        io:println(" Restaurant ID : ", check ord.restaurantId);
                        io:println(" Status        : ", check ord.status);
                        io:println(" Total Price   : $", check ord.totalPrice);
                        io:println(" Order Date    : ", check ord.createdAt);
                        io:println(" Last Updated  : ", check ord.updatedAt);
                        if ord.items is json[] {
                            io:println(" Items Ordered :");
                            json[] items = <json[]>check ord.items;
                            foreach json item in items {
                                string itemId = check item.itemId;
                                int qty = check int:fromString((check item.quantity).toString());
                                decimal price = check decimal:fromString((check item.price).toString());
                                io:println(string `   * Item ID: ${itemId} | Qty: ${qty} | Unit Price: $${price}`);
                            }
                        }
                        io:println("======================================================================");
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("Error: Order or Delivery ID '" + id + "' not found.");
                    } else {
                        io:println("Error: Status " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "7" => {
                string custId = io:readln("Enter Customer ID: ").trim();
                if custId == "" {
                    io:println("Error: Customer ID cannot be empty.");
                    continue;
                }
                do {
                    http:Response res = check orderClient->get("/customer/" + custId);
                    if res.statusCode == http:STATUS_OK {
                        json payload = check res.getJsonPayload();
                        json[] orders = <json[]>payload;
                        
                        if orders.length() == 0 {
                            io:println(string `\nNo past order history found for Customer ID '${custId}'.`);
                        } else {
                            io:println("\n======================================================================");
                            io:println(string ` CUSTOMER ORDER HISTORY (Customer ID: ${custId})`);
                            io:println("======================================================================");
                            foreach json ord in orders {
                                string orderId = check ord.id;
                                string restId = check ord.restaurantId;
                                string deliveryId = check ord.deliveryId;
                                string status = check ord.status;
                                decimal totalPrice = check decimal:fromString((check ord.totalPrice).toString());
                                string createdAt = check ord.createdAt;
                                
                                io:println(string ` Order ID       : ${orderId}`);
                                io:println(string ` Delivery ID    : ${deliveryId}`);
                                io:println(string ` Restaurant ID : ${restId}`);
                                io:println(string ` Status        : ${status}`);
                                io:println(string ` Total Price   : $${totalPrice}`);
                                io:println(string ` Order Date    : ${createdAt}`);
                                io:println(" Items:");
                                json[] items = <json[]>check ord.items;
                                foreach json item in items {
                                    string itemId = check item.itemId;
                                    int qty = check int:fromString((check item.quantity).toString());
                                    decimal price = check decimal:fromString((check item.price).toString());
                                    io:println(string `   - Item ID: ${itemId} | Qty: ${qty} | Unit Price: $${price}`);
                                }
                                io:println("----------------------------------------------------------------------");
                            }
                        }
                    } else {
                        io:println("Error: Failed to fetch order history. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: Unable to fetch order history (" + err.message() + ")");
                }
            }
            "8" => {
                string orderId = io:readln("Enter Order ID or Delivery ID to Cancel: ").trim();
                if orderId == "" {
                    io:println("Error: Order ID cannot be empty.");
                    continue;
                }
                do {
                    http:Response res = check orderClient->post("/" + orderId + "/cancel", ());
                    if res.statusCode == http:STATUS_OK {
                        io:println("\nOrder cancelled successfully! Customer balance has been refunded, restaurant stock restored, and driver released.");
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("Error: Order ID '" + orderId + "' not found.");
                    } else if res.statusCode == http:STATUS_BAD_REQUEST {
                        io:println("Error: Cannot cancel order (order may already be delivered).");
                    } else {
                        io:println("Error: Failed to cancel order. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "9" => { break; }
            _ => { io:println("Invalid option. Please enter 1 to 9."); }
        }
    }
}

// ---------------- RESTAURANT MENU ----------------
function handleRestaurantMenu() {
    while true {
        io:println("\n-- Restaurant Menu --");
        io:println("1. Register New Restaurant");
        io:println("2. Add Menu Items");
        io:println("3. Restock Menu Items (Update Inventory)");
        io:println("4. View Restaurant Profile");
        io:println("5. View Restaurant Orders & Update Status");
        io:println("6. Back to Main Menu");
        
        string choice = io:readln("Enter choice: ");
        match choice.trim() {
            "1" => {
                io:println("\n[ Register New Restaurant ]");
                string name = io:readln("Enter Name: ").trim();
                string address = io:readln("Enter Address: ").trim();
                
                if name == "" || address == "" {
                    io:println("Error: Name and address cannot be empty.");
                    continue;
                }
                
                json restaurantPayload = {
                    id: "", // Auto-generated by backend
                    name: name,
                    address: address,
                    menu: [],
                    inventory: {},
                    isOpen: true
                };
                
                do {
                    http:Response res = check restaurantClient->post("/", restaurantPayload);
                    if res.statusCode == http:STATUS_CREATED {
                        json registered = check res.getJsonPayload();
                        io:println("\nRestaurant registered successfully!");
                        io:println("Assigned Restaurant ID: ", check registered.id);
                        io:println(registered);
                    } else {
                        io:println("Error: Failed to register restaurant. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: Unable to communicate with Restaurant Service. (" + err.message() + ")");
                }
            }
            "2" => {
                string id = io:readln("Enter Restaurant ID: ").trim();
                string itemId = io:readln("Enter Menu Item ID (e.g. pizza_01): ").trim();
                string itemName = io:readln("Enter Menu Item Name: ").trim();
                string priceStr = io:readln("Enter Price: ").trim();
                
                decimal|error priceRes = decimal:fromString(priceStr);
                if priceRes is error || priceRes <= 0.0d {
                    io:println("Error: Invalid price! Please enter a positive numerical value.");
                    continue;
                }
                
                json[] menuItems = [{
                    id: itemId,
                    name: itemName,
                    price: priceRes
                }];
                
                do {
                    http:Response res = check restaurantClient->post("/" + id + "/menu", menuItems);
                    if res.statusCode == http:STATUS_OK {
                        io:println("Menu item added successfully!");
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("Error: Restaurant ID '" + id + "' not found.");
                    } else {
                        io:println("Error: Failed to add menu item. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "3" => {
                string id = io:readln("Enter Restaurant ID: ").trim();
                string itemId = io:readln("Enter Menu Item ID: ").trim();
                string qtyStr = io:readln("Enter Stock Quantity to Add: ").trim();
                
                int|error qtyRes = int:fromString(qtyStr);
                if qtyRes is error || qtyRes <= 0 {
                    io:println("Error: Invalid quantity! Please enter a positive whole number.");
                    continue;
                }
                
                json payload = {
                    items: {
                        [itemId]: qtyRes
                    }
                };
                
                do {
                    http:Response res = check restaurantClient->post("/" + id + "/inventory", payload);
                    if res.statusCode == http:STATUS_OK {
                        io:println("Inventory updated successfully!");
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("Error: Restaurant ID '" + id + "' not found.");
                    } else {
                        io:println("Error: Failed to update inventory. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "4" => {
                string id = io:readln("Enter Restaurant ID: ").trim();
                do {
                    http:Response res = check restaurantClient->get("/" + id);
                    if res.statusCode == http:STATUS_OK {
                        io:println("\nRestaurant Profile:");
                        io:println(check res.getJsonPayload());
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("Error: Restaurant ID '" + id + "' not found.");
                    } else {
                        io:println("Error: Status " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "5" => {
                string restId = io:readln("Enter Restaurant ID: ").trim();
                if restId == "" {
                    io:println("Error: Restaurant ID cannot be empty.");
                    continue;
                }
                do {
                    http:Response res = check restaurantClient->get("/" + restId + "/orders");
                    if res.statusCode == http:STATUS_OK {
                        json payload = check res.getJsonPayload();
                        json[] orders = <json[]>payload;
                        if orders.length() == 0 {
                            io:println("No active orders found for Restaurant ID: " + restId);
                        } else {
                            io:println("\n======================================================================");
                            io:println(" RESTAURANT ORDERS (Restaurant ID: " + restId + ")");
                            io:println("======================================================================");
                            foreach json ord in orders {
                                string oId = check ord.id;
                                string dId = check ord.deliveryId;
                                string cId = check ord.customerId;
                                string st = check ord.status;
                                decimal tp = check decimal:fromString((check ord.totalPrice).toString());
                                io:println(string ` Order ID       : ${oId}`);
                                io:println(string ` Delivery ID    : ${dId}`);
                                io:println(string ` Customer ID    : ${cId}`);
                                io:println(string ` Status        : ${st}`);
                                io:println(string ` Total Price   : $${tp}`);
                                io:println("----------------------------------------------------------------------");
                            }
                            string actionChoice = io:readln("Would you like to update an order status? (y/n): ").trim().toLowerAscii();
                            if actionChoice == "y" {
                                string orderId = io:readln("Enter Order ID to Update: ").trim();
                                io:println("Available Status Options: PREPARING, READY, OUT_FOR_DELIVERY");
                                string newStatus = io:readln("Enter New Status: ").trim().toUpperAscii();
                                
                                http:Response updateRes = check restaurantClient->post("/" + restId + "/orders/" + orderId + "/status", { status: newStatus });
                                if updateRes.statusCode == http:STATUS_OK {
                                    io:println(string `Order ${orderId} status updated to ${newStatus} successfully!`);
                                } else {
                                    io:println("Failed to update status. Status code: " + updateRes.statusCode.toString());
                                }
                            }
                        }
                    } else {
                        io:println("Error: Failed to fetch restaurant orders. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "6" => { break; }
            _ => { io:println("Invalid option. Please enter 1 to 6."); }
        }
    }
}

// ---------------- ORDER MENU ----------------
function handleOrderMenu() {
    while true {
        io:println("\n-- Orders Menu --");
        io:println("1. Place an Order");
        io:println("2. Track Order Status");
        io:println("3. Back to Main Menu");
        
        string choice = io:readln("Enter choice: ");
        match choice.trim() {
            "1" => {
                io:println("\n[ Place an Order ]");
                string custId = io:readln("Enter Customer ID: ").trim();
                string restId = io:readln("Enter Restaurant ID: ").trim();
                string itemId = io:readln("Enter Menu Item ID: ").trim();
                string qtyStr = io:readln("Enter Quantity: ").trim();
                
                if custId == "" || restId == "" || itemId == "" {
                    io:println("Error: Customer ID, Restaurant ID, and Menu Item ID are required.");
                    continue;
                }
                
                int|error qtyRes = int:fromString(qtyStr);
                if qtyRes is error || qtyRes <= 0 {
                    io:println("Error: Invalid quantity! Please enter a positive whole number.");
                    continue;
                }
                
                json payload = {
                    customerId: custId,
                    restaurantId: restId,
                    items: [
                        {
                            itemId: itemId,
                            quantity: qtyRes
                        }
                    ]
                };
                
                do {
                    http:Response res = check orderClient->post("/", payload);
                    if res.statusCode == http:STATUS_CREATED {
                        json registered = check res.getJsonPayload();
                        io:println("\nOrder placed successfully!");
                        io:println("Assigned Order ID: ", check registered.id);
                        io:println(registered);
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("Error: Specified Customer ID or Restaurant ID was not found.");
                    } else if res.statusCode == http:STATUS_BAD_REQUEST {
                        io:println("Error: Order request failed. Check menu item ID, stock, or customer balance.");
                    } else {
                        io:println("Error: Failed to place order. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: Unable to communicate with Order Service. (" + err.message() + ")");
                }
            }
            "2" => {
                string id = io:readln("Enter Order ID: ").trim();
                do {
                    http:Response res = check orderClient->get("/" + id);
                    if (res.statusCode == http:STATUS_OK) {
                        io:println("\nOrder Status Details:");
                        io:println(check res.getJsonPayload());
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("Error: Order ID '" + id + "' not found.");
                    } else {
                        io:println("Error: Status " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "3" => { break; }
            _ => { io:println("Invalid option."); }
        }
    }
}

// ---------------- DELIVERY MENU ----------------
function handleDeliveryMenu() {
    while true {
        io:println("\n-- Delivery Menu --");
        io:println("1. Register Delivery Driver");
        io:println("2. Simulate Delivery Completion (Driver marks delivered)");
        io:println("3. List All Drivers");
        io:println("4. List All Active/Pending Deliveries");
        io:println("5. View Driver Assigned Deliveries & Instructions");
        io:println("6. Back to Main Menu");
        
        string choice = io:readln("Enter choice: ");
        match choice.trim() {
            "1" => {
                io:println("\n[ Register Delivery Driver ]");
                string name = io:readln("Enter Driver Name: ").trim();
                string password = io:readln("Enter Driver Password: ").trim();
                string confirmPassword = io:readln("Confirm Driver Password: ").trim();
                
                if name == "" || password == "" {
                    io:println("Error: Driver Name and Password cannot be empty.");
                    continue;
                }
                
                if password != confirmPassword {
                    io:println("Error: Passwords do not match! Please try again.");
                    continue;
                }
                
                json driver = {
                    id: "", // Auto-generated by backend
                    name: name,
                    password: password,
                    status: "AVAILABLE"
                };
                
                do {
                    http:Response res = check deliveryClient->post("/drivers", driver);
                    if res.statusCode == http:STATUS_CREATED {
                        json registered = check res.getJsonPayload();
                        io:println("\n======================================================================");
                        io:println(" DRIVER REGISTRATION SUCCESSFUL");
                        io:println("======================================================================");
                        io:println(" Driver ID   : ", check registered.id);
                        io:println(" Driver Name : ", check registered.name);
                        io:println(" Status      : ", check registered.status);
                        io:println("======================================================================");
                    } else {
                        io:println("Failed to register driver. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "2" => {
                string deliveryId = io:readln("Enter Delivery ID (e.g. del_12345678): ").trim();
                string password = io:readln("Enter Driver Password: ").trim();

                if deliveryId == "" || password == "" {
                    io:println("Error: Delivery ID and Password are required.");
                    continue;
                }

                do {
                    http:Response res = check deliveryClient->post("/" + deliveryId + "/complete", { password: password });
                    if res.statusCode == http:STATUS_OK {
                        io:println("\n======================================================================");
                        io:println(" DELIVERY COMPLETED SUCCESSFULLY!");
                        io:println(" Driver is now available for new orders.");
                        io:println("======================================================================");
                    } else if res.statusCode == http:STATUS_UNAUTHORIZED {
                        io:println("Error: Incorrect driver password provided!");
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("Error: Delivery ID '" + deliveryId + "' not found.");
                    } else {
                        io:println("Failed to complete delivery. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "3" => {
                do {
                    http:Response res = check deliveryClient->get("/drivers");
                    if res.statusCode == http:STATUS_OK {
                        json payload = check res.getJsonPayload();
                        json[] drivers = <json[]>payload;
                        if drivers.length() == 0 {
                            io:println("\nNo registered delivery drivers found.");
                        } else {
                            io:println("\n======================================================================");
                            io:println(" REGISTERED DELIVERY DRIVERS");
                            io:println("======================================================================");
                            foreach json drv in drivers {
                                string drvId = check drv.id;
                                string drvName = check drv.name;
                                string status = check drv.status;
                                io:println(string ` Driver ID   : ${drvId}`);
                                io:println(string ` Driver Name : ${drvName}`);
                                io:println(string ` Status      : ${status}`);
                                io:println("----------------------------------------------------------------------");
                            }
                            io:println("======================================================================");
                        }
                    } else {
                        io:println("Failed to fetch drivers.");
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "4" => {
                do {
                    http:Response res = check deliveryClient->get("/");
                    if res.statusCode == http:STATUS_OK {
                        json payload = check res.getJsonPayload();
                        json[] deliveries = <json[]>payload;
                        if deliveries.length() == 0 {
                            io:println("\nNo active or pending deliveries found.");
                        } else {
                            io:println("\n======================================================================");
                            io:println(" ALL ACTIVE / PENDING DELIVERIES");
                            io:println("======================================================================");
                            foreach json del in deliveries {
                                string delId = check del.id;
                                string orderId = check del.orderId;
                                string driverId = check del.driverId;
                                string status = check del.status;
                                string assignedAt = check del.assignedAt;
                                string completedAt = check del.completedAt;
                                
                                io:println(string ` Delivery ID : ${delId}`);
                                io:println(string ` Order ID    : ${orderId}`);
                                io:println(string ` Driver ID   : ${driverId == "" ? "(Unassigned)" : driverId}`);
                                io:println(string ` Status      : ${status}`);
                                io:println(string ` Assigned At : ${assignedAt == "" ? "N/A" : assignedAt}`);
                                io:println(string ` Completed At: ${completedAt == "" ? "N/A" : completedAt}`);
                                io:println("----------------------------------------------------------------------");
                            }
                            io:println("======================================================================");
                        }
                    } else {
                        io:println("Failed to fetch deliveries.");
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "5" => {
                string driverId = io:readln("Enter Driver ID: ").trim();
                string password = io:readln("Enter Driver Password: ").trim();
                if driverId == "" || password == "" {
                    io:println("Error: Driver ID and Password are required.");
                    continue;
                }
                do {
                    http:Response res = check deliveryClient->get(string `/driver/${driverId}?password=${password}`);
                    if res.statusCode == http:STATUS_OK {
                        json payload = check res.getJsonPayload();
                        json[] list = <json[]>payload;
                        if list.length() == 0 {
                            io:println("\nNo active deliveries assigned to Driver ID: " + driverId);
                        } else {
                            io:println("\n======================================================================");
                            io:println(" ASSIGNED DELIVERIES & INSTRUCTIONS FOR DRIVER: " + driverId);
                            io:println("======================================================================");
                            foreach json del in list {
                                string dId = check del.id;
                                string oId = check del.orderId;
                                string st = check del.status;
                                string aAt = check del.assignedAt;
                                io:println(string ` Delivery ID : ${dId}`);
                                io:println(string ` Order ID    : ${oId}`);
                                io:println(string ` Status      : ${st}`);
                                io:println(string ` Assigned At : ${aAt}`);
                                io:println(" Instructions: Pick up order from restaurant and deliver to customer address.");
                                io:println("----------------------------------------------------------------------");
                            }
                            io:println("======================================================================");
                        }
                    } else if res.statusCode == http:STATUS_UNAUTHORIZED {
                        io:println("Error: Incorrect password provided for Driver ID '" + driverId + "'!");
                    } else {
                        io:println("Error: Failed to fetch driver deliveries. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: " + err.message());
                }
            }
            "6" => { break; }
            _ => { io:println("Invalid option. Please enter 1 to 6."); }
        }
    }
}

// ---------------- ADMIN REPORT MENU ----------------
function handleAdminMenu() {
    while true {
        io:println("\n-- Admin Reports Menu --");
        io:println("1. View Restaurant Performance Reports");
        io:println("2. View Global Delivery Statistics");
        io:println("3. Back to Main Menu");
        
        string choice = io:readln("Enter choice: ");
        match choice.trim() {
            "1" => {
                io:println("\n[ Restaurant Performance Reports ]");
                do {
                    http:Response res = check adminClient->get("/restaurants");
                    if res.statusCode == http:STATUS_OK {
                        json payload = check res.getJsonPayload();
                        json[] reports = <json[]>payload;
                        
                        if reports.length() == 0 {
                            io:println("\nNo restaurant performance reports compiled yet.");
                            io:println("Reports are updated automatically as orders are confirmed and prepared by restaurants.");
                        } else {
                            io:println("\n======================================================================");
                            foreach json rep in reports {
                                string restId = check rep.id;
                                int totalOrders = check int:fromString((check rep.totalOrders).toString());
                                decimal totalRevenue = check decimal:fromString((check rep.totalRevenue).toString());
                                int totalPrepTime = check int:fromString((check rep.totalPrepTimeSeconds).toString());
                                decimal avgPrepTime = check decimal:fromString((check rep.avgPrepTimeSeconds).toString());
                                
                                io:println(string ` Restaurant ID        : ${restId}`);
                                io:println(string ` Total Orders Prepared : ${totalOrders}`);
                                io:println(string ` Total Revenue         : $${totalRevenue}`);
                                io:println(string ` Total Prep Time       : ${totalPrepTime} seconds`);
                                io:println(string ` Average Prep Time     : ${avgPrepTime} seconds per order`);
                                io:println("----------------------------------------------------------------------");
                            }
                            io:println("======================================================================");
                        }
                    } else {
                        io:println("Error: Failed to fetch restaurant reports. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: Unable to fetch restaurant reports (" + err.message() + ")");
                }
            }
            "2" => {
                io:println("\n[ Global Delivery Statistics ]");
                do {
                    http:Response res = check adminClient->get("/deliveries");
                    if res.statusCode == http:STATUS_OK {
                        json rep = check res.getJsonPayload();
                        int totalDeliveries = check int:fromString((check rep.totalDeliveries).toString());
                        int totalDeliveryTime = check int:fromString((check rep.totalDeliveryTimeSeconds).toString());
                        decimal avgDeliveryTime = check decimal:fromString((check rep.avgDeliveryTimeSeconds).toString());
                        
                        io:println("\n======================================================================");
                        io:println(string ` Total Completed Deliveries : ${totalDeliveries}`);
                        io:println(string ` Total Delivery Time       : ${totalDeliveryTime} seconds`);
                        io:println(string ` Average Delivery Time     : ${avgDeliveryTime} seconds per delivery`);
                        io:println("======================================================================");
                    } else if res.statusCode == http:STATUS_NOT_FOUND {
                        io:println("\nNo delivery statistics compiled yet.");
                        io:println("Statistics update automatically as drivers complete order deliveries.");
                    } else {
                        io:println("Error: Failed to fetch delivery reports. Status: " + res.statusCode.toString());
                    }
                } on fail error err {
                    io:println("Connection error: Unable to fetch delivery reports (" + err.message() + ")");
                }
            }
            "3" => { break; }
            _ => { io:println("Invalid option."); }
        }
    }
}

// Helper to validate email format
function isValidEmail(string email) returns boolean {
    if email.length() < 5 || !email.includes("@") || !email.includes(".") {
        return false;
    }
    int atIdx = <int>email.indexOf("@");
    int dotIdx = <int>email.lastIndexOf(".");
    if atIdx < 1 || dotIdx <= atIdx + 1 || dotIdx == email.length() - 1 {
        return false;
    }
    return true;
}
